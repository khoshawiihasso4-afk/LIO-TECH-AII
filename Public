/* =========================================================================
   TAB 4: AI IMAGE CREATOR LOGIC (GEMINI 3.1 FLASH IMAGE)
   ========================================================================= */
const DAILY_LIMIT = 10;

function getTodayString() {
  const d = new Date();
  return `${d.getFullYear()}-${d.getMonth() + 1}-${d.getDate()}`;
}

function getImageUsage() {
  const stored = localStorage.getItem("lio-image-usage-data");
  if (stored) {
    const parsed = JSON.parse(stored);
    if (parsed.date === getTodayString()) return parsed;
  }
  const fresh = { date: getTodayString(), count: 0 };
  localStorage.setItem("lio-image-usage-data", JSON.stringify(fresh));
  return fresh;
}

function updateImageCounterUI() {
  const usage = getImageUsage();
  const counterEl = document.getElementById("imgDailyCounter");
  if (counterEl) {
    counterEl.textContent = `${DAILY_LIMIT - usage.count} / ${DAILY_LIMIT}`;
  }
}

async function generateImage() {
  const promptInput = document.getElementById("imagePrompt");
  const promptText = promptInput.value.trim();
  const ratio = document.getElementById("imageRatio").value;
  const style = document.getElementById("imageStyle").value;
  const btn = document.getElementById("generateImgBtn");
  const btnText = document.getElementById("generateImgBtnText");

  if (!promptText) {
    showToast("تکایە سەرەتا وەسفی وێنەکەت بنووسە.");
    return;
  }

  const usage = getImageUsage();
  if (usage.count >= DAILY_LIMIT) {
    showToast("توانای دروستکردنی وێنەی ئه‌مرۆت تەواو بووە. سبەی دووبارە ھەوڵ بدەرەوە!");
    return;
  }

  btn.disabled = true;
  btnText.textContent = "✨ LIO AI وێنەکە دروست دەکات...";

  const finalPrompt = `Create a high quality image:
Prompt: ${promptText}
Visual Style: ${style}
Aspect Ratio: ${ratio}`;

  const payload = {
    contents: [
      {
        role: "user",
        parts: [{ text: finalPrompt }]
      }
    ],
    generationConfig: {
      responseModalities: ["IMAGE"],
      imageConfig: { aspectRatio: ratio }
    }
  };

  const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_IMAGE_MODEL}:generateContent?key=${apiKey}`;

  try {
    const response = await fetch(apiUrl, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });

    const data = await response.json();
    if (!response.ok) throw new Error(data?.error?.message || "Gemini Image API Error");

    const candidate = data?.candidates?.[0];
    const part = candidate?.content?.parts?.find(p => p.inlineData);

    if (!part || !part.inlineData?.data) {
      throw new Error("وێنەکە لەلایەن سێرڤەرەوە دابین نەکرا.");
    }

    const mimeType = part.inlineData.mimeType || "image/png";
    const imageUrl = `data:${mimeType};base64,${part.inlineData.data}`;

    // Update usage
    usage.count += 1;
    localStorage.setItem("lio-image-usage-data", JSON.stringify(usage));
    updateImageCounterUI();

    // Render in gallery
    renderImageInGallery(imageUrl, promptText);
    showToast("وێنەکە بەسەرکەوتوویی دروستکرا!");

  } catch (err) {
    showToast(`هەڵە لە دروستکردنی وێنە: ${err.message}`);
    console.error("Image Gen Error:", err);
  }

  btn.disabled = false;
  btnText.textContent = "✨ دروستکردنی وێنە";
}

function renderImageInGallery(url, promptStr) {
  const gallery = document.getElementById("imageGallery");
  const emptyMsg = document.getElementById("emptyGalleryMsg");
  if (emptyMsg) emptyMsg.remove();

  const card = document.createElement("div");
  card.className = "bg-[var(--card-bg)] border border-[var(--card-border)] rounded-2xl overflow-hidden shadow-lg space-y-2 p-2 transition-all hover:scale-[1.02]";

  card.innerHTML = `
    <img src="${url}" alt="Generated Image" class="w-full aspect-square object-cover rounded-xl cursor-pointer" onclick="window.open('${url}', '_blank')">
    <p class="text-[11px] text-[var(--text-muted)] px-1 truncate font-medium" title="${escapeHtml(promptStr)}">${escapeHtml(promptStr)}</p>
    <a href="${url}" download="LIO-AI-Image.png" class="block w-full py-2 bg-purple-500/10 text-purple-500 hover:bg-purple-500 hover:text-white rounded-xl text-center text-xs font-bold transition-all">
      ⬇️ دابەزاندن (Download)
    </a>
  `;

  gallery.prepend(card);
}


/* =========================================================================
   GENERIC GEMINI TEXT API CALLER
   ========================================================================= */
async function callGeminiTextAPI(systemInstruction, contents) {
  const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/${GEMINI_TEXT_MODEL}:generateContent?key=${apiKey}`;

  const payload = {
    systemInstruction: { parts: [{ text: systemInstruction }] },
    contents: contents,
    generationConfig: { temperature: 0.4, maxOutputTokens: 2048 }
  };

  let retryDelay = 1000;
  for (let attempt = 0; attempt < 3; attempt++) {
    try {
      const res = await fetch(apiUrl, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });

      if (res.status === 429 && attempt < 2) {
        await new Promise(r => setTimeout(r, retryDelay));
        retryDelay *= 2;
        continue;
      }

      const data = await res.json();
      if (!res.ok) throw new Error(data?.error?.message || `API Error ${res.status}`);

      const text = data?.candidates?.[0]?.content?.parts?.map(p => p.text || "").join("").trim();
      return text || "هیچ وەڵامێک نەدۆزرایەوە.";

    } catch (e) {
      if (attempt === 2) throw e;
      await new Promise(r => setTimeout(r, retryDelay));
      retryDelay *= 2;
    }
  }
}


