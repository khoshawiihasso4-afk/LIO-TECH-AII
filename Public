          <span class="text-2xl mb-2 block group-hover:scale-110 transition-transform">⚡</span>
          <strong class="block text-sm font-bold">خێرایی & پرۆسێسەر</strong>
          <span class="text-xs text-[var(--text-muted)]">Snapdragon, Bionic</span>
