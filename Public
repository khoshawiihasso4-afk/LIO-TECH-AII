async function translateMovieAI(movie) {
  const prompt = `Translate & summarize this movie into natural Kurdish Sorani.
Title: ${movie.title}
Overview: ${movie.overview}
Genres: ${(movie.genres || []).map(g => g.name).join(", ")}

Format output clearly in Kurdish Sorani with:
• ناوی فیلم بە کوردی
• پوختەی چیرۆک
• جۆری فیلم`;

  try {
    const text = await callGeminiTextAPI("You are a movie translator into Kurdish Sorani.", [{ role: 'user', parts: [{ text }]}]);
    const el = document.getElementById("translationText");
    if (el) {
      el.classList.remove("animate-pulse", "text-gray-400");
      el.innerHTML = marked.parse(text);
    }
  } catch (err) {
    const el = document.getElementById("translationText");
    if (el) el.textContent = "نەتوانرا وەرگێڕان بەرهەم بهێنرێت.";
  }
}

