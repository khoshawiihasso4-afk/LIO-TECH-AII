          <span class="text-2xl mb-2 block group-hover:scale-110 transition-transform">💰</span>
          <strong class="block text-sm font-bold">بودجەی گونجاو</strong>
          <span class="text-xs text-[var(--text-muted)]">Best Value</span>
        </button>

        <button onclick="askMobileCategory('کامیان باشترە؟ iPhone 16 Pro Max یان Samsung S25 Ultra؟')" class="p-4 rounded-2xl border border-[var(--card-border)] bg-[var(--card-bg)] hover:border-blue-500/50 hover:scale-[1.02] transition-all shadow-sm group text-right">
          <span class="text-2xl mb-2 block group-hover:scale-110 transition-transform">🍎</span>
          <strong class="block text-sm font-bold">iPhone vs Android</strong>
          <span class="text-xs text-[var(--text-muted)]">iOS vs One UI</span>
        </button>

        <button onclick="askMobileCategory('باشترین ئەپەکانی سڕینەوەی ڤایرۆس و خێراکردنی مۆبایل کامەن؟')" class="p-4 rounded-2xl border border-[var(--card-border)] bg-[var(--card-bg)] hover:border-blue-500/50 hover:scale-[1.02] transition-all shadow-sm group text-right">
          <span class="text-2xl mb-2 block group-hover:scale-110 transition-transform">📲</span>
          <strong class="block text-sm font-bold">ئەپە بەسوودەکان</strong>
          <span class="text-xs text-[var(--text-muted)]">Security, Speed</span>
