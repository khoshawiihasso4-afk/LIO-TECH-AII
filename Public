<!DOCTYPE html>
<html lang="ku" dir="rtl" class="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#08080a">
<title>LIO TECH Suite — Created by KHOSHAWII HASSO</title>

<!-- Fonts & External Libraries -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Noto+Kufi+Arabic:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

<script>
  tailwind.config = {
    darkMode: 'class',
    theme: {
      extend: {
        colors: {
          brand: {
            red: '#ff4d4d',
            orange: '#ff9f43',
            blue: '#007aff',
            purple: '#5856d6',
            green: '#20bf6b',
            darkBg: '#08080a',
            darkCard: '#121216',
            darkBorder: '#22222a'
          }
        },
        fontFamily: {
          sans: ['"Plus Jakarta Sans"', '"Noto Kufi Arabic"', 'sans-serif']
        }
      }
    }
  }
</script>

<style>
:root {
  --bg-color: #f4f5f8;
  --card-bg: #ffffff;
  --card-border: #e2e4e9;
  --text-main: #0f172a;
  --text-muted: #64748b;
  --accent-red: #ff4d4d;
  --accent-blue: #007aff;
  --header-bg: rgba(255, 255, 255, 0.85);
}

.dark {
  --bg-color: #08080a;
  --card-bg: #121216;
  --card-border: #22222a;
  --text-main: #f8fafc;
  --text-muted: #94a3b8;
  --accent-red: #ff4d4d;
  --accent-blue: #38bdf8;
  --header-bg: rgba(18, 18, 22, 0.85);
}

body {
  background-color: var(--bg-color);
  color: var(--text-main);
  font-family: 'Plus Jakarta Sans', 'Noto Kufi Arabic', sans-serif;
  transition: background-color 0.3s ease, color 0.3s ease;
}

.glass-nav {
  background: var(--header-bg);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--card-border);
}

.gradient-btn-red {
  background: linear-gradient(135deg, #ff4d4d, #ff7676);
  box-shadow: 0 4px 20px rgba(255, 77, 77, 0.35);
}

.gradient-btn-red:hover {
  box-shadow: 0 6px 25px rgba(255, 77, 77, 0.5);
}

.gradient-btn-blue {
  background: linear-gradient(135deg, #007aff, #5856d6);
  box-shadow: 0 4px 20px rgba(0, 122, 255, 0.35);
}

.gradient-btn-blue:hover {
  box-shadow: 0 6px 25px rgba(0, 122, 255, 0.5);
}

.gradient-btn-whatsapp {
  background: linear-gradient(135deg, #25D366, #128C7E);
  box-shadow: 0 4px 20px rgba(37, 211, 102, 0.35);
}

.gradient-btn-whatsapp:hover {
  box-shadow: 0 6px 25px rgba(37, 211, 102, 0.5);
}

.markdown-body h1, .markdown-body h2, .markdown-body h3 {
  font-weight: 700;
  margin-top: 0.8rem;
  margin-bottom: 0.4rem;
}
.markdown-body h2 { font-size: 1.2rem; color: #ff4d4d; }
.markdown-body ul { list-style-type: disc; padding-inline-start: 1.2rem; margin: 0.4rem 0; }
.markdown-body ol { list-style-type: decimal; padding-inline-start: 1.2rem; margin: 0.4rem 0; }
.markdown-body strong { font-weight: 700; color: #10b981; }
.markdown-body code {
  background: rgba(150, 150, 150, 0.15);
  padding: 0.15rem 0.35rem;
  border-radius: 6px;
  font-size: 0.88em;
}

::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track { background: transparent; }
::-webkit-scrollbar-thumb {
  background: rgba(140, 140, 140, 0.3);
  border-radius: 10px;
}
::-webkit-scrollbar-thumb:hover { background: rgba(140, 140, 140, 0.5); }

.tab-content {
  display: none;
}
.tab-content.active {
  display: block;
  animation: fadeIn 0.35s ease-in-out forwards;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}
</style>
</head>

<body class="min-h-screen flex flex-col antialiased">

<!-- TOP HEADER NAVBAR -->
<header class="sticky top-0 z-50 glass-nav transition-colors">
  <div class="max-w-7xl mx-auto px-4 h-16 flex items-center justify-between gap-2">
    
    <!-- Logo & Brand -->
    <div class="flex items-center gap-3 cursor-pointer" onclick="switchTab('kurdish-ai')">
      <div class="w-10 h-10 rounded-2xl flex items-center justify-center text-white font-black text-xl gradient-btn-red shadow-lg">
        L
      </div>
      <div>
        <div class="flex items-center gap-1.5">
          <span class="text-lg font-black tracking-tight">LIO <span class="text-red-500">TECH</span></span>
          <span class="text-[10px] px-2 py-0.5 rounded-full bg-red-500/10 text-red-500 font-extrabold border border-red-500/20">SUITE</span>
        </div>
        <p class="text-[10px] text-gray-500 dark:text-gray-400 font-medium">By KHOSHAWII HASSO</p>
      </div>
    </div>

    <!-- Navigation Tabs (Desktop) -->
    <nav class="hidden md:flex items-center gap-1 bg-gray-200/60 dark:bg-gray-800/60 p-1.5 rounded-2xl border border-[var(--card-border)] text-xs font-bold">
      <button onclick="switchTab('kurdish-ai')" id="tab-btn-kurdish-ai" class="nav-tab-btn px-4 py-2 rounded-xl transition-all flex items-center gap-2 text-gray-700 dark:text-gray-300 hover:text-red-500">
        <i class="fa-solid fa-robot"></i>
        <span id="navKurdishAiText">کوردستان AI</span>
      </button>
      <button onclick="switchTab('mobile-advisor')" id="tab-btn-mobile-advisor" class="nav-tab-btn px-4 py-2 rounded-xl transition-all flex items-center gap-2 text-gray-700 dark:text-gray-300 hover:text-blue-500">
        <i class="fa-solid fa-mobile-screen-button"></i>
        <span id="navMobileText">ڕاوێژکاری مۆبایل</span>
      </button>
      <button onclick="switchTab('movies')" id="tab-btn-movies" class="nav-tab-btn px-4 py-2 rounded-xl transition-all flex items-center gap-2 text-gray-700 dark:text-gray-300 hover:text-amber-500">
        <i class="fa-solid fa-film"></i>
        <span id="navMoviesText">فیلمەکان</span>
      </button>
      <button onclick="switchTab('image-creator')" id="tab-btn-image-creator" class="nav-tab-btn px-4 py-2 rounded-xl transition-all flex items-center gap-2 text-gray-700 dark:text-gray-300 hover:text-purple-500">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        <span id="navImageText">دروستکردنی وێنە</span>
      </button>
    </nav>

    <!-- Action Controls -->
    <div class="flex items-center gap-2">
      <!-- WhatsApp Direct Support -->
      <button onclick="openWhatsAppModal()" class="px-3 py-2 text-xs font-bold text-white rounded-xl gradient-btn-whatsapp transition-all flex items-center gap-1.5 shadow-md" title="پەیوەندی بە WhatsApp">
        <i class="fa-brands fa-whatsapp text-sm"></i>
        <span class="hidden sm:inline" id="headerWhatsappText">پشتیوانی WhatsApp</span>
      </button>

      <!-- Language Toggle -->
      <button onclick="toggleLanguage()" class="w-9 h-9 rounded-xl border border-[var(--card-border)] bg-[var(--card-bg)] hover:bg-red-500/10 hover:text-red-500 transition-all flex items-center justify-center font-bold text-xs" title="گۆڕینی زمان">
        🌐
      </button>

      <!-- Theme Switcher -->
      <button onclick="toggleDarkMode()" class="w-9 h-9 rounded-xl border border-[var(--card-border)] bg-[var(--card-bg)] hover:bg-amber-500/10 hover:text-amber-500 transition-all flex items-center justify-center text-sm" title="تاریک / ڕۆشن">
        <i id="themeIcon" class="fa-solid fa-moon"></i>
      </button>
    </div>

  </div>

  <!-- Mobile Navigation Bar -->
  <div class="md:hidden flex items-center justify-around bg-[var(--card-bg)] border-t border-[var(--card-border)] py-2 px-1 text-[11px] font-bold">
    <button onclick="switchTab('kurdish-ai')" id="mob-btn-kurdish-ai" class="mob-tab-btn flex flex-col items-center gap-1 p-1 text-gray-500">
      <i class="fa-solid fa-robot text-base"></i>
      <span>کوردستان AI</span>
    </button>
    <button onclick="switchTab('mobile-advisor')" id="mob-btn-mobile-advisor" class="mob-tab-btn flex flex-col items-center gap-1 p-1 text-gray-500">
      <i class="fa-solid fa-mobile-screen-button text-base"></i>
      <span>مۆبایل</span>
    </button>
    <button onclick="switchTab('movies')" id="mob-btn-movies" class="mob-tab-btn flex flex-col items-center gap-1 p-1 text-gray-500">
      <i class="fa-solid fa-film text-base"></i>
      <span>فیلم</span>
    </button>
    <button onclick="switchTab('image-creator')" id="mob-btn-image-creator" class="mob-tab-btn flex flex-col items-center gap-1 p-1 text-gray-500">
      <i class="fa-solid fa-wand-magic-sparkles text-base"></i>
      <span>وێنە</span>
    </button>
  </div>
</header>

<!-- MAIN APP WRAPPER -->
<main class="flex-1 max-w-7xl w-full mx-auto px-4 py-6">

  <!-- ========================================================================= -->
  <!-- TAB 1: KURDISH AI ASSISTANT -->
  <!-- ========================================================================= -->
  <section id="tab-kurdish-ai" class="tab-content active space-y-6">
    
    <!-- Hero Banner -->
    <div class="rounded-3xl p-6 sm:p-10 text-white shadow-2xl relative overflow-hidden bg-gradient-to-r from-red-600 via-rose-600 to-amber-600">
      <div class="absolute -right-10 -bottom-10 w-72 h-72 bg-white/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="relative z-10 max-w-3xl space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-extrabold">
          <i class="fa-solid fa-bolt text-amber-300"></i>
          <span>LIO TECH Kurdish AI • Powered by Gemini 3 Flash</span>
        </div>

        <h1 id="kurdishHeroTitle" class="text-3xl sm:text-5xl font-black leading-tight">
          یاریدەدەری زیرەکی دەستکرد بە زمانی کوردی
        </h1>

        <p id="kurdishHeroDesc" class="text-sm sm:text-base opacity-95 leading-relaxed font-medium">
          پرسیارەکەت بکە و وەڵامی دروست، خێرا و ڕێکخراو بە کوردیی سۆرانی وەربگرە. بەرهمهێنراوە لەلایەن KHOSHAWII HASSO.
        </p>

        <div class="pt-2 flex flex-wrap gap-2 text-xs">
          <button onclick="openWhatsAppModal('پەیام لەسەر LIO AI')" class="px-4 py-2 rounded-xl bg-white/20 hover:bg-white/30 backdrop-blur-md font-bold transition-all flex items-center gap-1.5">
            <i class="fa-brands fa-whatsapp"></i>
            <span>پشتیوانی ڕاستەوخۆ</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Quick Ask Chips -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 scrollbar-none text-xs">
      <span class="font-bold text-gray-500 whitespace-nowrap" id="quickAskLabel">پێشنیاری خێرا:</span>
      <button onclick="setKurdishPrompt('چۆن iPhone ـەکەم خێراتر بکەم؟')" class="px-3 py-2 rounded-xl bg-[var(--card-bg)] border border-[var(--card-border)] hover:border-red-500 transition-all whitespace-nowrap shadow-sm">📱 خێراکردنی iPhone</button>
      <button onclick="setKurdishPrompt('بۆچی Android ـەکەم خاوە و چۆن چاکی بکەم؟')" class="px-3 py-2 rounded-xl bg-[var(--card-bg)] border border-[var(--card-border)] hover:border-red-500 transition-all whitespace-nowrap shadow-sm">🤖 خێراکردنی Android</button>
      <button onclick="setKurdishPrompt('چۆن تەندروستی باتری مۆبایل بپارێزم؟')" class="px-3 py-2 rounded-xl bg-[var(--card-bg)] border border-[var(--card-border)] hover:border-red-500 transition-all whitespace-nowrap shadow-sm">🔋 پاراستنی باتری</button>
      <button onclick="setKurdishPrompt('باشترین ئەپەکانی ساڵی 2026 بۆ مۆبایل کامەن؟')" class="px-3 py-2 rounded-xl bg-[var(--card-bg)] border border-[var(--card-border)] hover:border-red-500 transition-all whitespace-nowrap shadow-sm">📲 ئەپە بەسوودەکان</button>
    </div>

    <!-- Chat Box Workspace -->
    <div class="p-5 sm:p-7 rounded-3xl border border-[var(--card-border)] bg-[var(--card-bg)] shadow-xl space-y-5">
      
      <div class="flex items-center justify-between border-b border-[var(--card-border)] pb-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 rounded-2xl flex items-center justify-center text-white font-black text-lg gradient-btn-red">
            LIO
          </div>
          <div>
            <h2 class="text-base font-bold flex items-center gap-2">
              <span>LIO AI Assistant</span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
            </h2>
            <p class="text-xs text-[var(--text-muted)]" id="kurdishSubhead">وەڵامدەرەوەی پرسیارەکان بە زمانی کوردی</p>
          </div>
        </div>

        <button onclick="clearKurdishChat()" class="px-3 py-1.5 text-xs font-semibold rounded-xl border border-[var(--card-border)] hover:bg-red-500/10 hover:text-red-500 transition-all flex items-center gap-1.5" title="پاککردنەوە">
          <i class="fa-solid fa-trash-can"></i>
          <span class="hidden sm:inline" id="clearKurdishBtnText">پاککردنەوە</span>
        </button>
      </div>

      <!-- Messages History -->
      <div id="kurdishChatHistory" class="space-y-4 max-h-[500px] overflow-y-auto pr-1">
        <!-- Appended dynamically -->
      </div>

      <!-- Input Area -->
      <div class="space-y-3 pt-2">
        <div class="relative">
          <textarea
            id="kurdishInput"
            rows="3"
            class="w-full p-4 rounded-2xl border border-[var(--card-border)] bg-[var(--bg-color)] text-sm focus:outline-none focus:border-red-500 focus:ring-2 focus:ring-red-500/20 transition-all resize-none"
            placeholder="پرسیارەکەت لێرە بنووسە بە زمانی کوردی یان ئینگلیزی..."
          ></textarea>
        </div>

        <div class="flex items-center justify-between gap-3">
          <div class="text-xs text-[var(--text-muted)]">
            <span id="creatorTag">دروستکراوە لەلایەن: <strong class="text-red-500">KHOSHAWII HASSO</strong></span>
          </div>

          <button
            id="sendKurdishBtn"
            onclick="sendKurdishMessage()"
            class="py-3 px-6 rounded-xl gradient-btn-red text-white font-extrabold text-sm flex items-center justify-center gap-2 cursor-pointer disabled:opacity-50"
          >
            <i class="fa-solid fa-paper-plane text-xs"></i>
            <span id="sendKurdishBtnLabel">ناردنی پرسیار</span>
          </button>
        </div>
      </div>

    </div>

  </section>


  <!-- ========================================================================= -->
  <!-- TAB 2: MOBILE ADVISOR & TROUBLESHOOTING -->
  <!-- ========================================================================= -->
  <section id="tab-mobile-advisor" class="tab-content space-y-6">
    
    <!-- Hero Banner -->
    <div class="rounded-3xl p-6 sm:p-10 text-white shadow-2xl relative overflow-hidden bg-gradient-to-r from-blue-600 via-indigo-600 to-purple-600">
      <div class="relative z-10 max-w-3xl space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-xs font-extrabold">
          <i class="fa-solid fa-mobile-screen text-cyan-300"></i>
          <span>LIO AI • Mobile Specialist</span>
        </div>

        <h1 id="mobileHeroTitle" class="text-3xl sm:text-5xl font-black leading-tight">
          ڕاوێژکاری مۆبایل و چارەسەری کێشەکان
        </h1>

        <p id="mobileHeroDesc" class="text-sm sm:text-base opacity-95 leading-relaxed font-medium">
          دیاریکردنی باشترین مۆبایل بۆ یاری، کامێرا، باتری و نرخ، لەگەڵ چارەسەری کێشەکانی iOS و Android.
        </p>

        <!-- Quick Search -->
        <div class="pt-2 flex flex-col sm:flex-row gap-2">
          <input
            id="mobileQuickInput"
            type="text"
            class="flex-1 px-4 py-3 rounded-2xl bg-white text-gray-900 placeholder-gray-400 text-sm font-medium focus:outline-none shadow-inner"
            placeholder="کێشەکەت بنووسە یان بپرسە کێشەی چی هەیه..."
          >
          <button 
            onclick="askMobileQuick()"
            class="px-6 py-3 rounded-2xl bg-gray-900 hover:bg-black text-white font-bold text-sm shadow-lg transition-all flex items-center justify-center gap-2"
          >
            <span id="mobileAskText">پرسیار بکه</span>
            <i class="fa-solid fa-paper-plane text-xs"></i>
          </button>
        </div>
      </div>
    </div>

    <!-- Category Grid -->
    <div class="space-y-3">
      <div class="flex items-center justify-between">
        <h2 class="text-base font-extrabold flex items-center gap-2">
          <i class="fa-solid fa-layer-group text-blue-500"></i>
          <span id="mobCatTitle">بەشەکانی پێشنیارکردنی مۆبایل</span>
        </h2>
        <span class="text-xs text-[var(--text-muted)]">کلیک بکە بۆ ڕاوێژکاری</span>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-right">
        <button onclick="askMobileCategory('باشترین مۆبایل بۆ یاری PUBG و FPS بەرەو سەرەوە کامەیە؟')" class="p-4 rounded-2xl border border-[var(--card-border)] bg-[var(--card-bg)] hover:border-blue-500/50 hover:scale-[1.02] transition-all shadow-sm group text-right">
          <span class="text-2xl mb-2 block group-hover:scale-110 transition-transform">🎮</span>
          <strong class="block text-sm font-bold">یاری & Gaming</strong>
          <span class="text-xs text-[var(--text-muted)]">FPS, Cooling, GPU</span>
        </button>

        <button onclick="askMobileCategory('باشترین مۆبایل بۆ کامێرا و وێنەگرتنی شەو کامەیە؟')" class="p-4 rounded-2xl border border-[var(--card-border)] bg-[var(--card-bg)] hover:border-blue-500/50 hover:scale-[1.02] transition-all shadow-sm group text-right">
          <span class="text-2xl mb-2 block group-hover:scale-110 transition-transform">📸</span>
          <strong class="block text-sm font-bold">کامێرا & ڤیدیۆ</strong>
          <span class="text-xs text-[var(--text-muted)]">4K, OIS, Portrait</span>
        </button>

        <button onclick="askMobileCategory('باشترین مۆبایل لە ڕووی بەرگەگرتنی باتری و شارژی خێرا کامەیە؟')" class="p-4 rounded-2xl border border-[var(--card-border)] bg-[var(--card-bg)] hover:border-blue-500/50 hover:scale-[1.02] transition-all shadow-sm group text-right">
          <span class="text-2xl mb-2 block group-hover:scale-110 transition-transform">🔋</span>
          <strong class="block text-sm font-bold">باتری & شارژ</strong>
          <span class="text-xs text-[var(--text-muted)]">mAh, Fast Charge</span>
