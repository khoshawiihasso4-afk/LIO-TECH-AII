function renderMoviesGrid(list, append = false) {
  const container = document.getElementById("moviesGrid");
  if (!append && !list.length) {
    container.innerHTML = `<div class="col-span-full text-center py-10 text-gray-400">هیچ فیلمێک نەدۆزرایەوە.</div>`;
    return;
  }

  const html = list.map(m => {
    const poster = m.poster_path ? `https://image.tmdb.org/t/p/w500${m.poster_path}` : "https://placehold.co/500x750/1f2937/ffffff?text=No+Poster";
    const year = m.release_date ? m.release_date.slice(0, 4) : "N/A";
    const rating = m.vote_average ? m.vote_average.toFixed(1) : "N/A";

    return `
      <div onclick="openMovieDetails(${m.id})" class="bg-[var(--card-bg)] border border-[var(--card-border)] rounded-2xl overflow-hidden cursor-pointer hover:scale-[1.03] hover:border-amber-500/50 transition-all shadow-md group">
        <div class="relative aspect-[2/3] bg-gray-800">
          <img src="${poster}" alt="${escapeHtml(m.title)}" loading="lazy" class="w-full h-full object-cover group-hover:opacity-90 transition-opacity">
          <span class="absolute top-2 right-2 bg-black/70 backdrop-blur-md text-amber-400 font-bold text-[11px] px-2 py-0.5 rounded-lg">⭐ ${rating}</span>
        </div>
        <div class="p-3">
          <h4 class="font-extrabold text-xs truncate">${escapeHtml(m.title)}</h4>
          <p class="text-[10px] text-[var(--text-muted)] mt-1">${year}</p>
        </div>
      </div>
    `;
  }).join("");

  if (append) {
    container.insertAdjacentHTML('beforeend', html);
  } else {
    container.innerHTML = html;
  }
}

