async function tmdbFetch(path, params = {}) {
  const url = new URL(`https://api.themoviedb.org/3${path}`);
  url.searchParams.set("api_key", TMDB_API_KEY);
  Object.entries(params).forEach(([k, v]) => url.searchParams.set(k, v));

  const res = await fetch(url);
  if (!res.ok) throw new Error(`TMDB Error ${res.status}`);
  return res.json();
}

async function loadMovieGenres() {
  try {
    const data = await tmdbFetch("/genre/movie/list", { language: "en-US" });
    movieGenresList = data.genres || [];
    const container = document.getElementById("movieGenresContainer");
    container.innerHTML = "";

    movieGenresList.forEach(genre => {
      const chip = document.createElement("button");
      chip.className = "px-3 py-1.5 rounded-xl border border-[var(--card-border)] bg-[var(--card-bg)] hover:border-amber-500 hover:text-amber-500 transition-all whitespace-nowrap font-medium shadow-sm";
      chip.textContent = genre.name;
      chip.onclick = () => loadMovieGenre(genre.id, genre.name);
      container.appendChild(chip);
    });
  } catch (e) {
    console.error("Genres load error:", e);
  }
}

async function loadMovieCategory(category, btn = null) {
  if (btn) {
    document.querySelectorAll(".movie-cat-btn").forEach(b => {
      b.className = "movie-cat-btn px-4 py-2 rounded-xl bg-[var(--card-bg)] border border-[var(--card-border)] hover:border-amber-500 transition-all";
    });
    btn.className = "movie-cat-btn px-4 py-2 rounded-xl bg-amber-500 text-white transition-all shadow-md";
  }

  const titles = { popular: "Popular Movies", now_playing: "Now Playing", top_rated: "Top Rated", upcoming: "Upcoming Movies" };
  document.getElementById("movieSectionTitle").textContent = titles[category] || "Movies";

  movieActiveCategory = category;
  movieCurrentPage = 1;
  showMoviesGridLoading();

  try {
    const data = await tmdbFetch(`/movie/${category}`, { page: 1, language: "en-US" });
    movieTotalPages = data.total_pages || 1;
    currentMoviesList = data.results || [];
    renderMoviesGrid(currentMoviesList, false);
  } catch (err) {
    document.getElementById("moviesGrid").innerHTML = `<div class="col-span-full text-center text-red-500 py-10">${err.message}</div>`;
  }
}

