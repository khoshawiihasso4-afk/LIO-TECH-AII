   ========================================================================= */
function appendMessageUI(containerId, role, text, avatarLabel = "LIO") {
  const container = document.getElementById(containerId);
  if (!container) return;

  const isUser = role === "user";
  const div = document.createElement("div");
  div.className = `flex gap-2.5 ${isUser ? 'justify-end' : 'justify-start'} animate-fade-in`;

  const parsedText = typeof marked !== 'undefined' ? marked.parse(text) : text;

  div.innerHTML = `
    ${!isUser ? `
      <div class="w-8 h-8 rounded-xl gradient-btn-red text-white flex items-center justify-center font-black text-xs shrink-0 mt-1">
        ${avatarLabel}
      </div>
    ` : ''}

    <div class="max-w-[85%] sm:max-w-[78%] rounded-2xl p-3.5 text-xs sm:text-sm leading-relaxed ${
      isUser 
        ? 'bg-red-600 text-white rounded-br-none rtl:rounded-br-2xl rtl:rounded-bl-none' 
        : 'bg-[var(--bg-color)] border border-[var(--card-border)] text-[var(--text-main)] rounded-bl-none rtl:rounded-bl-2xl rtl:rounded-br-none'
    }">
      <div class="markdown-body">
        ${parsedText}
      </div>
      
      ${!isUser ? `
        <div class="mt-2.5 pt-1.5 border-t border-[var(--card-border)] flex items-center justify-between text-[10px] text-[var(--text-muted)]">
          <div class="flex items-center gap-2">
            <button onclick="copyToClipboard(this)" data-text="${encodeURIComponent(text)}" class="hover:text-red-500 transition-colors flex items-center gap-1">
              <i class="fa-regular fa-copy"></i>
              <span>کۆپی</span>
            </button>
            <button onclick="speakText(this)" data-text="${encodeURIComponent(text.replace(/[*_#]/g, ''))}" class="hover:text-red-500 transition-colors flex items-center gap-1">
              <i class="fa-solid fa-volume-high"></i>
              <span>دەنگ</span>
            </button>
          </div>
          <span>LIO TECH</span>
        </div>
      ` : ''}
    </div>

    ${isUser ? `
      <div class="w-8 h-8 rounded-xl bg-gray-700 text-white flex items-center justify-center font-bold text-xs shrink-0 mt-1">
        <i class="fa-solid fa-user"></i>
      </div>
    ` : ''}
  `;

  container.appendChild(div);
  container.scrollTop = container.scrollHeight;
}

function copyToClipboard(btn) {
  const text = decodeURIComponent(btn.getAttribute("data-text"));
  const tempInput = document.createElement("textarea");
  tempInput.value = text;
  document.body.appendChild(tempInput);
  tempInput.select();
  document.execCommand("copy");
  document.body.removeChild(tempInput);
  showToast("کۆپی کرا!");
}

function speakText(btn) {
  const text = decodeURIComponent(btn.getAttribute("data-text"));
  if ('speechSynthesis' in window) {
    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(text);
    utterance.lang = currentLang === 'ku' ? 'ar-SA' : 'en-US';
    window.speechSynthesis.speak(utterance);
    showToast("خوێندنەوەی دەنگی دەستی پێکرد...");
  } else {
    showToast("Text-to-speech not supported.");
  }
}

function escapeHtml(str) {
  return String(str || "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}
